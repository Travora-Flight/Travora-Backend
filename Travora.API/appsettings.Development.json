{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=TravoraDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "PUT_YOUR_SECRET_KEY_HERE_MAKE_IT_LONG_ENOUGH_32_CHARS",
    "Issuer": "Travora",
    "Audience": "TravoraUsers",
    "ExpiryDays": 7
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "Travora:"
  },
  "SignalR": {
    "EnableRedisBackplane": false
  },
  "MailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseSsl": false,
    "Username": "PUT_YOUR_EMAIL",
    "Password": "PUT_APP_PASSWORD",
    "FromEmail": "no-reply@travora.com",
    "FromName": "Travora"
  },
  "AirlineApi": {
    "BaseUrl": "http://travora-airline.runasp.net",
    "TimeoutSeconds": 10
  },
  "AviationEdge": {
    "BaseUrl": "https://aviation-edge.com/v2/public",
    "ApiKey": "PUT_YOUR_KEY",
    "TimeoutSeconds": 10
  },
  "AviationWeather": {
    "BaseUrl": "https://aviationweather.gov/api/data",
    "CacheTtlMinutes": 30
  },
  "CloudinarySettings": {
    "CloudName": "PUT_CLOUD_NAME",
    "ApiKey": "PUT_API_KEY",
    "ApiSecret": "PUT_API_SECRET"
  },
  "Geocoding": {
    "Provider": "Nominatim",
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "Travora/1.0"
  },
  "PassportOcr": {
    "ConfidenceThreshold": 0.85,
    "ManualReviewThreshold": 0.60
  },
  "SeedSettings": {
    "AutoSeedOnStartup": true,
    "SeedOrder": [ "countries", "cities", "airports", "airlines", "aircraft" ]
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "HangfireSettings": {
    "DashboardPath": "/hangfire"
  }
}
